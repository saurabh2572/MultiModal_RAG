# Local demo access gate. Use a strong random value; do not commit your real .env.
RAG_ACCESS_TOKEN=replace-with-a-long-random-token

# Paths for the fully indexed chunks.jsonl. Trial indexes require matching chunks.
RAG_CHUNKS_PATH=data/processed/tata_motors_doc/chunks.jsonl
RAG_VECTOR_DB_DIR=data/vector_db/tata_motors_doc
RAG_KEYWORD_DB_PATH=data/search_index/tata_motors_doc.sqlite3
RAG_DEVICE=cpu
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# Google supports retrieved image crops in the answer prompt.
RAG_LLM_PROVIDER=google
RAG_LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=

# Alternative local text-only answer path:
# RAG_LLM_PROVIDER=ollama
# RAG_LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Existing LANGCHAIN_* tracing settings are also accepted.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multimodal-rag
